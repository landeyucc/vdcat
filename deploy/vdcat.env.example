# ===== vdcat 服务端环境变量配置 =====
# 复制为 vdcat.env 并按实际修改；systemd 通过 EnvironmentFile 加载

# 监听地址（服务器部署用 0.0.0.0；端口可改）
VDCAT_ADDR=0.0.0.0:8626

# SQLite 数据库路径（任务历史/配置持久化，建议放在挂载的数据盘）
VDCAT_DB=/opt/vdcat/data/vdcat.db

# 文件下载目录
VDCAT_DOWNLOAD_DIR=/opt/vdcat/downloads

# 并发下载数（默认 2）
VDCAT_CONCURRENCY=4

# 解析策略：1=优先 GraphQL 接口（失败自动回退 HTML）；0=直接 HTML 提取
VDCAT_USE_API=1

# 是否写入视频同名 .json 元数据：1/0
VDCAT_WRITE_META=1

# ===== 登录鉴权（二选一或同时配置；都不配置则不启用登录，仅限内网！）=====
# 方式一：管理员账号密码（前端用它换取 Bearer Token）
VDCAT_ADMIN_USER=admin
VDCAT_ADMIN_PASSWORD=change-me-strong-password

# 方式二：固定访问令牌（设置后前端可直接用此 Token 登录 / 作为 Authorization: Bearer <token>）
# VDCAT_TOKEN=your-long-random-secret-token

# Token 签名密钥（可选；配置后服务重启不会使已登录会话失效。留空则每次重启重新生成）
# 建议用: openssl rand -hex 32
VDCAT_SECRET=

# 服务器上通常无桌面，保持 1 禁用自动打开浏览器
VDCAT_NO_BROWSER=1
