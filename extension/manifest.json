{
  "manifest_version": 3,
  "name": "VDCat 视频下载助手",
  "version": "1.1.0",
  "description": "在浏览器面板中解析并下载抖音、快手视频，支持作者主页批量嗅探下载，对接自托管 VDCat 服务。",
  "icons": {
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_title": "VDCat 视频下载助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "256": "icons/icon-256.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.kuaishou.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "clipboardWrite", "downloads", "webRequest"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ]
}
