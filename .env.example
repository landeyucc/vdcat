# ===== VDCAT 配置模板 =====
# 复制为 .env 并按需修改；.env 不会被提交到 Git。

# 登录用户名与密码（配置密码后即开启登录鉴权）
VDCAT_ADMIN_USER=admin
VDCAT_ADMIN_PASSWORD=please-change-me

# 可选：固定访问令牌（Bearer Token），留空则不启用
VDCAT_TOKEN=

# 可选：会话签名密钥，配置后重启不导致已登录会话失效
# VDCAT_SECRET=

# 监听地址
VDCAT_ADDR=0.0.0.0:8626

# 下载目录（服务器绝对路径）
# VDCAT_DOWNLOAD_DIR=

# 并发任务数
VDCAT_CONCURRENCY=2

# 设为 1 时启动不自动打开浏览器
VDCAT_NO_BROWSER=0
